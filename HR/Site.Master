<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="HR.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - HRFusion</title>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <style>
        /* Sticky Footer Layout */
        html, body {
            height: 100%;
            margin: 0;
        }
        .main-wrapper {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        .content {
            flex: 1; /* Pushes footer to bottom */
        }
        .footer {
            background: #0b2e4e;
            color: white;
            text-align: center;
            padding: 10px 0;
        }
    </style>
</head>
<body>
    <form runat="server" class="main-form">
        <div class="main-wrapper">
            <!-- Navbar -->
            <nav class="navbar navbar-expand-sm navbar-dark" style="background-color: #0b2e4e;">
                <div class="container">
                    <a class="navbar-brand" runat="server" href="~/">HRFusion</a>
                    <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse d-sm-inline-flex justify-content-end">
                        <ul class="navbar-nav">
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/">Home</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/About">About</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Contact">Contact</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/UI/EmployeeInformation.aspx">Employee</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/UI/CompanySetup.aspx">Company</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/UI/DepartmentSetup.aspx">Department</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/UI/AttendanceEntry.aspx">Attendance</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/UI/LeaveEntry.aspx">Leave</a></li>
                        </ul>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <div class="container content mt-4">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>

            <!-- Footer -->
            <footer class="footer">
                <p class="mb-0">&copy; <%: DateTime.Now.Year %> - <b>HRFusion</b>. All rights reserved.</p>
            </footer>
        </div>
    </form>
</body>
</html>
